{
  "base_model": "facebook/galactica-6.7b",
  "device": {
    "prefer_cuda": true
  },
  "logging": {
    "run_dir": "runs",
    "save_every": 100,
    "tb_every_steps": 50,
    "val_every_steps": 500
  },
  "loss_weights": {
    "lambda_orm": 1.0,
    "lambda_prm": 0.5
  },
  "misc": {
    "max_seq_length": 512,
    "use_tokenizer_fast": true
  },
  "optim": {
    "betas": [
      0.9,
      0.95
    ],
    "lr": "2e-5",
    "warmup_steps": 500,
    "weight_decay": 0.01
  },
  "precision": "fp16",
  "run_name": "rm_galactica_v1",
  "seed": 12345,
  "tokenizer_name": "facebook/galactica-6.7b",
  "train": {
    "epochs": 2,
    "gradient_accumulation_steps": 8,
    "max_length": 512,
    "max_train_steps": 20000,
    "orm_train_jsonl": "data/train/orm_train.jsonl",
    "orm_val_jsonl": "data/val/orm_val.jsonl",
    "per_device_batch_size": 2,
    "prm_train_jsonl": "data/train/prm_train.jsonl",
    "prm_val_jsonl": "data/val/prm_val.jsonl",
    "save_every_steps": 2000
  }
}